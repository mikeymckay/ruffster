<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>FamilyActivityInstaller</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../bundle-extractor/FamilyActivity.BundleExtractor.csproj" />
    <EmbeddedResource Include="$(FamilyBundlePath)" LogicalName="FamilyActivityBundle.zip" />
  </ItemGroup>
  <Target Name="RequireFamilyBundle" BeforeTargets="PrepareForBuild" Condition="'$(FamilyBundlePath)' == ''">
    <Error Text="Set FamilyBundlePath to the Windows preview package archive." />
  </Target>
</Project>
